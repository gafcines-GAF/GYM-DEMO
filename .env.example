# Copiá este archivo a .env y completá los valores. El .env NUNCA se sube al repositorio.

# Clave secreta: generá una nueva para cada entorno con
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# True solo en tu computadora. En producción: False
DJANGO_DEBUG=False

# Hosts y orígenes permitidos, separados por coma (en minúsculas)
DJANGO_ALLOWED_HOSTS=gafarias.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://gafarias.pythonanywhere.com

# Ruta del panel de administración (sin barras al inicio). Cambiala por algo difícil de adivinar.
DJANGO_ADMIN_URL=admin/

# Opcional: duración de HSTS en segundos (por defecto 30 días)
# DJANGO_HSTS_SECONDS=2592000
